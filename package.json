{
  "name": "alalas-children",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Demo de combate FPS para un avatar cuadrúpedo, activada por voz con Vosk local o Web Speech.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/prepare_vosk_runtime.mjs && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:voice-audio": "node scripts/test_vosk_synthetic.mjs",
    "model:prepare": "python scripts/prepare_voice_model.py",
    "commands:export": "node --experimental-strip-types scripts/export_flame_commands.mjs",
    "build": "node --experimental-strip-types scripts/export_flame_commands.mjs && node scripts/prepare_vosk_runtime.mjs && tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server-dist/server.mjs",
    "start:open": "node server-dist/server.mjs --open"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0",
    "vosk-browser": "0.0.8",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "@types/ws": "^8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
